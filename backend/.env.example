# 模型服务（OpenAI 兼容接口，默认 OpenRouter）
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=sk-or-xxx
LLM_MODEL=deepseek/deepseek-v3.2
# 用于改写问题、生成资料概要等轻量任务，优先选首字延迟低的模型
LLM_FAST_MODEL=qwen/qwen3-next-80b-a3b-instruct
EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_API_KEY=sk-or-xxx
EMBEDDING_MODEL=openai/text-embedding-3-small
# 所选资料总字数不超过该值时走全文模式，否则走 RAG
FULL_CONTEXT_MAX_CHARS=40000
# 成本估算单价（美元 / 百万 token）
PRICE_INPUT_PER_M=0.3
PRICE_OUTPUT_PER_M=0.9
PRICE_EMBEDDING_PER_M=0.02
# 可选：同步追踪到 LangSmith
LANGSMITH_TRACING=false
